    "@fontsource/share-tech-mono": "^5.3.0",
    "@fontsource/zcool-qingke-huangyou": "^5.3.0",
    "@free-fonts/zhuque-fangsong": "^1.0.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@types/node": "^26.4.1",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^6.1.1",
    "typescript": "^5.5.4",
    "vite": "^8.3.1",
