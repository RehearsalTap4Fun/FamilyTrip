# 同路 · 攻略正文代取（server/fetch-server.mjs）。部署：scripts/deploy.sh 会同步到 /opt/trip 并重启
[Unit]
Description=Tonglu guide fetcher (fetches user-pasted travel guide links)
After=network.target

[Service]
User=admin
Environment=PORT=18795
ExecStart=/usr/bin/node /opt/trip/fetch-server.mjs
Restart=always
RestartSec=3
NoNewPrivileges=true

[Install]
WantedBy=multi-user.target
